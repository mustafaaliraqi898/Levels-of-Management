{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:promotion": "NODE_ENV=test tsx src/tests/promotion.test.ts",
    "test:print": "NODE_ENV=test tsx src/tests/print.test.ts",
    "test:status": "NODE_ENV=test tsx src/tests/studentStatus.test.ts",
    "test:security:frontend": "NODE_ENV=test tsx src/tests/securityFixes.test.ts",
    "test:security:main": "NODE_ENV=test tsx src/tests/mainProcessSecurity.test.ts",
    "test:security": "npm run test:security:frontend && npm run test:security:main",
    "test:integration": "NODE_ENV=test tsx src/tests/dbIntegration.test.ts",
    "test:recovery": "NODE_ENV=test tsx src/tests/recovery.test.ts",
    "test:smtp": "NODE_ENV=test tsx src/tests/smtp.test.ts",
    "test:all": "npm run test:security && npm run test:promotion && npm run test:print && npm run test:status && npm run test:recovery && npm run test:integration && npm run test:smtp",
    "electron:dev": "NODE_ENV=development electron electron/main.cjs",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jsdom": "^31.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sqlite3": "5.1.7",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.14",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "build": {
    "appId": "com.school.grades",
    "productName": "نظام إدارة الدرجات المدرسية",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "main": "electron/main.cjs"
}
